# Zotero Plugin Development Environment Configuration
# Copy this file to .env and adjust paths for your system.

# The path of the Zotero binary file
# macOS:   /Applications/Zotero.app/Contents/MacOS/zotero
# Linux:   /usr/lib/zotero/zotero (or wherever Zotero is installed)
# Windows: C:\Program Files\Zotero\zotero.exe
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero

# The path of the profile used for development.
# Use a relative path under the project to keep it portable.
# Do NOT set this to an empty string, otherwise scaffold default profile is overridden.
ZOTERO_PLUGIN_PROFILE_PATH=.scaffold/profile

# The directory where the database is located.
# Optional. Use a dedicated dev data dir to avoid locking your daily Zotero profile.
ZOTERO_PLUGIN_DATA_DIR=.scaffold/data
