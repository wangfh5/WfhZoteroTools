pref-title = WfhZoteroTools 设置
pref-enable =
    .label = 开启
pref-input = 输入
pref-chatpdf-scripts-dir = ChatPDF 脚本目录
pref-chatpdf-scripts-dir-input =
    .placeholder = /path/to/zotero-plugin-wfh/scripts/chatpdf-automation
pref-chatpdf-scripts-dir-desc = chatpdf-automation 脚本目录的绝对路径。请克隆仓库后将路径指向 scripts/chatpdf-automation 目录。
pref-node-path = Node.js 路径（可选）
pref-node-path-input =
    .placeholder = 留空则自动检测
pref-node-path-desc = Node.js 可执行文件的绝对路径。留空会自动从常见位置检测。
pref-chrome-user-data-dir = Chrome 用户数据目录（可选）
pref-chrome-user-data-dir-input =
    .placeholder = 留空使用默认隔离目录
pref-chrome-user-data-dir-desc-empty = • 留空 → 使用隔离的用户数据目录，路径为 ~/Library/Caches/ms-playwright/daemon/chatpdf-shared-profile（默认）。首次运行需手动登录，登录状态会跨次保持。
pref-chrome-user-data-dir-desc-custom = • 输入自定义绝对路径 → 使用该目录作为浏览器用户数据目录。
pref-chrome-user-data-dir-desc-note = ⚠ 请勿指向 Chrome 真实的用户数据目录——Playwright 会破坏登录状态。切换目录前需先关闭已有浏览器窗口再重新触发。
pref-help = { $name } Build { $version } { $time }